{
  "manifest_version": 3,
  "name": "Secure Password Manager",
  "version": "2.0",
  "description": "Securely store and retrieve website passwords with two-factor key file authentication.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "frontend/auth.html",
        "frontend/auth.css",
        "frontend/auth.js",
        "backend/crypto_utils.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "backend/background.js"
  },
  "action": {
    "default_popup": "frontend/popup.html",
    "default_title": "Open Password Manager"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "frontend/autofill.js"
      ],
      "run_at": "document_idle"
    }
  ]
}